#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer OutputBuffer {
    uint values[];
} outputBuffer;

void main()
{
    uint i = gl_GlobalInvocationID.x;

    if (i >= 64)
        return;

    outputBuffer.values[i] = 0x4C534647u + i;
}
