#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D frameA;
layout(set = 0, binding = 1, rgba8) uniform readonly image2D frameB;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D outputImage;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);

    if (p.x >= 64 || p.y >= 64)
        return;

    vec4 a = imageLoad(frameA, p);
    vec4 b = imageLoad(frameB, p);

    /*
     * Deterministic midpoint interpolation.
     *
     * This deliberately exercises:
     *   imageLoad(A)
     *   imageLoad(B)
     *   floating-point arithmetic
     *   imageStore(output)
     */
    vec4 result = a * 0.5 + b * 0.5;

    imageStore(outputImage, p, result);
}
