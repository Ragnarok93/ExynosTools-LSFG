#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8)
uniform readonly image2D frame_a;

layout(set = 0, binding = 1, rgba8)
uniform readonly image2D frame_b;

layout(set = 0, binding = 2, rgba8)
uniform writeonly image2D output_image;

layout(set = 0, binding = 3) uniform MotionParams {
    vec2 motion;
    float mode;
    float scale;
} params;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(output_image);

    if (p.x >= size.x || p.y >= size.y)
        return;

    /*
     * PHASE 2B-FIX1
     *
     * Motion-compensated two-frame interpolation.
     *
     * Pixel-center normalized coordinate:
     *
     *     uv = (p + 0.5) / size
     *
     * Frame A:
     *
     *     uv_a = uv + motion * scale
     *
     * Frame B:
     *
     *     uv_b = uv - motion * scale
     */

    vec2 uv =
        (vec2(p) + vec2(0.5)) /
        vec2(size);

    vec2 delta =
        params.motion * params.scale;

    vec2 uv_a =
        uv + delta;

    vec2 uv_b =
        uv - delta;

    /*
     * Convert normalized coordinates to integer pixels.
     */

    vec2 pa_f =
        floor(uv_a * vec2(size));

    vec2 pb_f =
        floor(uv_b * vec2(size));

    int pa_x = int(pa_f.x);
    int pa_y = int(pa_f.y);

    int pb_x = int(pb_f.x);
    int pb_y = int(pb_f.y);

    /*
     * Scalar integer clamping.
     *
     * Avoid vector SClamp because the Xclipse 940 driver
     * rejected the previous pipeline containing vector SClamp.
     */

    if (pa_x < 0)
        pa_x = 0;

    if (pa_x >= size.x)
        pa_x = size.x - 1;

    if (pa_y < 0)
        pa_y = 0;

    if (pa_y >= size.y)
        pa_y = size.y - 1;

    if (pb_x < 0)
        pb_x = 0;

    if (pb_x >= size.x)
        pb_x = size.x - 1;

    if (pb_y < 0)
        pb_y = 0;

    if (pb_y >= size.y)
        pb_y = size.y - 1;

    ivec2 pa =
        ivec2(pa_x, pa_y);

    ivec2 pb =
        ivec2(pb_x, pb_y);

    /*
     * Motion-compensated frame samples.
     */

    vec4 a =
        imageLoad(frame_a, pa);

    vec4 b =
        imageLoad(frame_b, pb);

    /*
     * Midpoint interpolation.
     */

    vec4 result =
        mix(a, b, 0.5);

    imageStore(
        output_image,
        p,
        result
    );
}
