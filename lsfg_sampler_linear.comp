#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D frameA;
layout(set = 0, binding = 1) uniform sampler2D frameB;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D outputImage;

void main()
{
    /*
     * Exact center between four texels:
     *
     *   (0,0) ---- (1,0)
     *     |          |
     *   (0,1) ---- (1,1)
     *
     * At normalized coordinate (1/64, 1/64), Vulkan's
     * normalized sampling coordinates are exactly halfway
     * between the four texel centers.
     */
    vec2 uv = vec2(1.0 / 64.0, 1.0 / 64.0);

    vec4 result = texture(frameA, uv);

    imageStore(outputImage, ivec2(0, 0), result);
}
