#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D frameA;
layout(set = 0, binding = 1) uniform sampler2D frameB;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D outputImage;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);

    if (p.x >= 64 || p.y >= 64)
        return;

    vec2 uv = (vec2(p) + vec2(0.5)) / vec2(64.0);

    /*
     * Synthetic horizontal motion.
     *
     * Frame A represents the object before motion.
     * Frame B represents the object after motion.
     *
     * The intermediate frame samples A and B from
     * opposite sides of the motion vector.
     */
    vec2 motion = vec2(-0.10, 0.0);

    vec2 uvA = uv - motion * 0.5;
    vec2 uvB = uv + motion * 0.5;

    vec4 a = texture(frameA, uvA);
    vec4 b = texture(frameB, uvB);

    vec4 result = a * 0.5 + b * 0.5;

    imageStore(outputImage, p, result);
}
