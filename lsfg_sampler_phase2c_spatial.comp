#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D frameA;
layout(set = 0, binding = 1) uniform sampler2D frameB;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D outputImage;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);

    if (p.x >= 64 || p.y >= 64)
        return;

    /*
     * Normalize output coordinates.
     *
     * Use texel-center coordinates so that every invocation
     * samples a distinct spatial location.
     */
    vec2 uv = (vec2(p) + vec2(0.5)) / vec2(64.0);

    /*
     * Synthetic horizontal motion field.
     *
     * A is sampled half a pixel to the left.
     * B is sampled half a pixel to the right.
     *
     * This approximates the basic structure of motion
     * compensation without requiring a motion-vector image.
     */
    float dx = 0.5 / 64.0;

    vec2 uvA = clamp(
        uv - vec2(dx, 0.0),
        vec2(0.0),
        vec2(1.0));

    vec2 uvB = clamp(
        uv + vec2(dx, 0.0),
        vec2(0.0),
        vec2(1.0));

    vec4 a = textureLod(frameA, uvA, 0.0);
    vec4 b = textureLod(frameB, uvB, 0.0);

    vec4 result = mix(a, b, 0.5);

    imageStore(outputImage, p, result);
}
